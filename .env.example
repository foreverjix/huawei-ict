# 复制本文件为 .env，填入自己的凭证后启动。
# .env 已被 .gitignore 忽略，不会进入仓库。

# 大模型：华为云 ModelArts Studio 的 API 地址 / 模型名 / API Key
# 也可填任意 OpenAI 兼容端点，例如 https://api.deepseek.com/v1 + deepseek-chat
MINDFLOW_LLM_BASE_URL=https://api.deepseek.com/v1
MINDFLOW_LLM_MODEL=deepseek-chat
MINDFLOW_LLM_API_KEY=

# 华为云 OCR：AK/SK 在「我的凭证 - 访问密钥」，PROJECT_ID 在「我的凭证 - 项目列表」
MINDFLOW_OCR_ENABLED=false
MINDFLOW_OCR_REGION=cn-north-4
MINDFLOW_OCR_PROJECT_ID=
MINDFLOW_OCR_AK=
MINDFLOW_OCR_SK=
# 留空时按 region 自动拼 https://ocr.{region}.myhuaweicloud.com
MINDFLOW_OCR_ENDPOINT=
MINDFLOW_OCR_MAX_PAGES=10
MINDFLOW_OCR_DPI=150

# 服务：演示时保持 127.0.0.1；要让局域网访问再改成 0.0.0.0
MINDFLOW_BIND_ADDRESS=127.0.0.1
MINDFLOW_H2_CONSOLE=false